Given an int array length 3, if there is a 2 in the array immediately followed by a 3, set the 3 element to 0. Return the changed array.

fix23([1, 2, 3]) → [1, 2, 0]
fix23([2, 3, 5]) → [2, 0, 5]
fix23([1, 2, 1]) → [1, 2, 1]

public int[] fix23(int[] nums) {
  
  if (check2FollowedBy3(nums, 0)) {
    nums[1] = 0;
  }
  else if (check2FollowedBy3(nums, 1)) {
    nums[2] = 0;
  }
  
  return nums;
  
}

private boolean check2FollowedBy3(int[] arr, int index) {
  
  return arr[index] == 2 && arr[index + 1] == 3;
  
}
