Start with 2 int arrays, a and b, of any length. Return how many of the arrays have 1 as their first element.

start1([1, 2, 3], [1, 3]) → 2
start1([7, 2, 3], [1]) → 1
start1([1, 2], []) → 1

public int start1(int[] a, int[] b) {
  
  int total = 0;
  
  total += start1For1(a);
  total += start1For1(b);
  
  return total;
  
}

private int start1For1(int[] arr) {
  
  if (arr.length != 0 && arr[0] == 1) return 1;
  
  return 0;
  
}
