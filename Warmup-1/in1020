Given 2 int values, return true if either of them is in the range 10..20 inclusive.

in1020(12, 99) → true
in1020(21, 12) → true
in1020(8, 99) → false

public boolean in1020(int a, int b) {
  
  return oneIn1020(a) || oneIn1020(b);
  
}

private boolean oneIn1020(int x) {
  
  return x >= 10 && x <= 20;
  
}
