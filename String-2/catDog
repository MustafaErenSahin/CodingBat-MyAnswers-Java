Return true if the string "cat" and "dog" appear the same number of times in the given string.

catDog("catdog") → true
catDog("catcat") → false
catDog("1cat1cadodog") → true

public boolean catDog(String str) {
  
  int count = 0;

  for (int i = 0; i < str.length() - 2; i++) {
    count += getValue(str, "cat", i);
    count -= getValue(str, "dog", i);
  }

  return count == 0;
  
}

private int getValue(String str, String animal, int index) {
  
  if (str.startsWith(animal, index)) return 1;
  
  return 0;
  
}
